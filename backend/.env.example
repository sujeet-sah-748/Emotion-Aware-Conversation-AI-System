# Emotion Chatbot Backend Configuration

# Ollama LLM Settings (Local inference - FREE!)
OLLAMA_MODEL=phi4-mini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TEMPERATURE=0.7
OLLAMA_MAX_TOKENS=1024

# Redis Cache Settings
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Mem0 Memory System Settings
MEM0_VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=
MEM0_EMBEDDER_PROVIDER=openai
MEM0_EMBEDDER_MODEL=text-embedding-3-small
MEM0_LLM_PROVIDER=
MEM0_LLM_MODEL=
MEM0_COLLECTION=emotion_chatbot_memories
MEM0_HISTORY_DB=./mem0_history.db
MEM0_ENABLE_GRAPH=false
MEM0_GRAPH_STORE=neo4j
NEO4J_URL=
NEO4J_USERNAME=
NEO4J_PASSWORD=

# OpenAI API (for Mem0 embeddings only - LLM uses Ollama)
OPENAI_API_KEY=

# Vector Store Settings (Legacy - replaced by Mem0)
USE_CHROMADB=true
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=emotion_memories

# Token Counter Settings
USE_TIKTOKEN=false

# Context Window Settings
MAX_CONTEXT_TOKENS=7168
RESERVED_TOKENS=1024

# Memory Retrieval Settings
TOP_K_MEMORIES=5
MEMORY_RECENCY_WEIGHT=0.2
MEMORY_SIMILARITY_WEIGHT=0.7
MEMORY_IMPORTANCE_WEIGHT=0.1
